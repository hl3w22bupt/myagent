{
  "name": "myagent",
  "version": "1.0.0",
  "description": "Motia-based Distributed Agent System with PTC Support",
  "type": "module",
  "scripts": {
    "postinstall": "motia install",
    "setup:hooks": "bash scripts/setup-git-hooks.sh",
    "dev": "PYTHON_PATH=./python_modules/bin/python3 motia dev",
    "start": "motia start",
    "generate-types": "motia generate-types",
    "build": "tsc && motia build",
    "build:ts": "tsc",
    "clean": "rm -rf dist node_modules python_modules .motia .mermaid .venv",
    "pre-commit": "bash scripts/pre-commit-check.sh",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "bash tests/integration/test-e2e.sh",
    "test:e2e:jest": "jest tests/integration/e2e.test.ts",
    "test:standalone": "bash scripts/test-standalone.sh",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ptc": "ts-node tests/manual/test-ptc-generation.ts",
    "test:glm4": "ts-node scripts/test-glm4.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.ts\"",
    "py:install": "uv pip install -r requirements.txt",
    "py:run": "uv run",
    "py:test": "uv run pytest",
    "py:lint": "uv run pylint **/*.py",
    "py:format": "uv run black .",
    "py:typecheck": "uv run mypy .",
    "pytest": "uvx pytest"
  },
  "keywords": [
    "motia",
    "agent",
    "distributed-system",
    "ptc",
    "llm"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@motiadev/adapter-bullmq-events": "0.17.11-beta.193",
    "@motiadev/core": "0.17.11-beta.193",
    "@motiadev/plugin-bullmq": "0.17.11-beta.193",
    "@motiadev/plugin-endpoint": "0.17.11-beta.193",
    "@motiadev/plugin-logs": "0.17.11-beta.193",
    "@motiadev/plugin-observability": "0.17.11-beta.193",
    "@motiadev/plugin-states": "0.17.11-beta.193",
    "@types/pg": "^8.16.0",
    "axios": "^1.6.2",
    "bullmq": "^5.1.8",
    "dotenv": "^16.3.1",
    "ioredis": "^5.3.2",
    "js-yaml": "^4.1.0",
    "motia": "0.17.11-beta.193",
    "openai": "^6.15.0",
    "pg": "^8.17.1",
    "sql.js": "^1.13.0",
    "uuid": "^9.0.1",
    "ws": "^8.16.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@motiadev/workbench": "0.17.11-beta.193",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.6",
    "@types/sql.js": "^1.4.9",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "playwright": "^1.40.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "eslintIgnore": [
    "node_modules",
    "dist",
    "python_modules",
    "jest.config.js",
    "types.d.ts",
    "tests/debug",
    "tests/manual",
    "tests/performance",
    "tests/integration"
  ]
}
