{
  "name": "myagent",
  "version": "1.0.0",
  "description": "Motia-based Distributed Agent System with PTC Support",
  "type": "module",
  "scripts": {
    "postinstall": "npm run precompile:knowledge",
    "setup": "bash scripts/setup-environment.sh",
    "setup:hooks": "bash scripts/setup-git-hooks.sh",
    "check:python-env": "bash scripts/check-python-env.sh",
    "predev": "npm run build:postgres && npm run check:python-env",
    "dev": "PYTHON_PATH=./python_modules/bin/python3 motia dev",
    "start": "motia start",
    "build:postgres": "tsc src/core/database/postgres-store.ts --outDir .motia/compiled/src/core/database --module ESNext --target ES2020 --moduleResolution node --esModuleInterop --skipLibCheck --allowSyntheticDefaultImports",
    "build:ts": "tsc",
    "generate-types": "npm run precompile:knowledge && motia generate-types",
    "precompile:knowledge": "bash scripts/precompile-knowledge.sh",
    "build": "tsc && motia build",
    "clean": "rm -rf dist node_modules python_modules .motia .mermaid .venv",
    "pre-commit": "bash scripts/pre-commit-check.sh",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "bash tests/integration/test-e2e.sh",
    "test:e2e:jest": "jest tests/integration/e2e.test.ts",
    "test:standalone": "bash scripts/test-standalone.sh",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ptc": "ts-node tests/manual/test-ptc-generation.ts",
    "postgres:start": "bash scripts/start-postgres.sh",
    "postgres:stop": "bash scripts/stop-postgres.sh",
    "postgres:env": "bash scripts/set-postgres-env.sh",
    "test:postgres": "bash scripts/start-postgres.sh && source scripts/set-postgres-env.sh && npm test && bash scripts/stop-postgres.sh",
    "test:glm4": "ts-node scripts/test-glm4.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.ts\"",
    "py:install": "uv pip install -r requirements.txt",
    "py:run": "uv run",
    "py:test": "uv run pytest",
    "py:lint": "uv run pylint **/*.py",
    "py:format": "uv run black .",
    "py:typecheck": "uv run mypy .",
    "pytest": "uvx pytest",
    "cleanup:task": "ts-node scripts/cleanup-old-tasks.ts",
    "db:init": "tsx scripts/init-postgres.ts",
    "db:reset": "tsx scripts/init-postgres.ts",
    "setup:knowledge-base": "tsx scripts/setup-knowledge-base.ts",
    "setup:app-knowledge-mappings": "tsx scripts/setup-app-knowledge-mappings.ts",
    "init:test-knowledge": "tsx scripts/init-test-knowledge.ts",
    "create-sample-knowledge": "tsx scripts/create-sample-knowledge.ts"
  },
  "keywords": [
    "motia",
    "agent",
    "distributed-system",
    "ptc",
    "llm"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@datastructures-js/priority-queue": "^6.3.5",
    "@lancedb/lancedb": "^0.5.2",
    "@types/handlebars": "^4.0.40",
    "@types/lru-cache": "^7.10.9",
    "@types/pg": "^8.16.0",
    "axios": "^1.6.2",
    "bullmq": "^5.1.8",
    "dotenv": "^16.3.1",
    "handlebars": "^4.7.8",
    "iii-sdk": "^0.11.0",
    "ioredis": "^5.3.2",
    "js-yaml": "^4.1.0",
    "lru-cache": "^11.2.7",
    "motia": "^1.0.4-rc.1",
    "openai": "^6.15.0",
    "pg": "^8.17.1",
    "sql.js": "^1.13.0",
    "uuid": "^9.0.1",
    "ws": "^8.16.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.6",
    "@types/sql.js": "^1.4.9",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "acpx": "^0.5.2",
    "antlr4ts": "^0.5.0-alpha.4",
    "esbuild": "^0.27.7",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "playwright": "^1.40.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "eslintIgnore": [
    "node_modules",
    "dist",
    "python_modules",
    "jest.config.js",
    "types.d.ts",
    "tests/debug",
    "tests/manual",
    "tests/performance",
    "tests/integration"
  ]
}
