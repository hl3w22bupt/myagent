### 会话超时清理

```typescript
class AgentManager {
  private setupSessionTimeout(sessionId: string): void {
    // 清除旧的超时
    if (this.sessionTimeouts.has(sessionId)) {
      clearTimeout(this.sessionTimeouts.get(sessionId)!);
    }

    // 设置新超时
    const timeout = setTimeout(async () => {
      console.log(`Session ${sessionId} timed out, releasing...`);
      await this.release(sessionId);
    }, this.sessionTimeout);

    this.sessionTimeouts.set(sessionId, timeout);
  }

  /**
   * 刷新会话超时
   */
  refreshSessionTimeout(sessionId: string): void {
    if (this.sessions.has(sessionId)) {
      this.setupSessionTimeout(sessionId);
    }
  }
}
```

## 原子操作

### 竞态条件问题

```
时间 ──────────────────────────────────────────────────────>

线程 1: 读取 counter = 10  ─────────────────── 写入 counter = 11

线程 2:         读取 counter = 10  ───────────────── 写入 counter = 11

结果: counter = 11 (应该是 12)
```

### StateLockManager 原子操作

```typescript
/**
 * 原子更新操作
 */
export class StateLockManager {
  private locks = new Map<string, Mutex>();

  async atomicUpdate<T>(
    state: State,
    groupId: string,
    key: string,
    updater: (current: T) => T
  ): Promise<void> {
    const lockKey = `${groupId}:${key}`;
    const mutex = this.getLock(lockKey);

    // 获取锁
    await mutex.acquire();

    try {
      // 读取当前值
      const current = await state.get(groupId, key);

      // 应用更新
      const updated = updater(current);

      // 写入更新值
      await state.set(groupId, key, updated);
    } finally {
      // 释放锁
      mutex.release();
    }
  }
}
```

### 原子数组合并

```typescript
/**
 * 原子数组合并
 */
export class StateLockManager {
  async atomicMerge<T extends object>(
    state: State,
    groupId: string,
    key: string,
    updates: Partial<T>
  ): Promise<void> {
    const lockKey = `${groupId}:${key}`;
    const mutex = this.getLock(lockKey);

    await mutex.acquire();

    try {
      const current = await state.get(groupId, key, {});
      const merged = { ...current, ...updates };
      await state.set(groupId, key, merged);
    } finally {
      mutex.release();
    }
  }
}
```

### 原子数组操作

```typescript
/**
 * 原子添加到数组
 */
export function safePushToArray<T>(
  arr: T[] | undefined,
  item: T
): T[] {
  return arr ? [...arr, item] : [item];
}

/**
 * 原子从数组移除
 */
export function safeRemoveFromArray<T>(
  arr: T[] | undefined,
  predicate: (item: T) => boolean
): T[] {
  if (!arr) return [];
  return arr.filter(item => !predicate(item));
}

/**
 * 原子数组更新
 */
export class StateLockManager {
  async atomicPush<T>(
    state: State,
    groupId: string,
    key: string,
    item: T
  ): Promise<void> {
    const lockKey = `${groupId}:${key}`;
    const mutex = this.getLock(lockKey);

    await mutex.acquire();

    try {
      const current = await state.get(groupId, key, []);
      const updated = safePushToArray(current, item);
      await state.set(groupId, key, updated);
    } finally {
      mutex.release();
    }
  }

  async atomicRemove<T>(
    state: State,
    groupId: string,
    key: string,
    predicate: (item: T) => boolean
  ): Promise<void> {
    const lockKey = `${groupId}:${key}`;
    const mutex = this.getLock(lockKey);

    await mutex.acquire();

    try {
      const current = await state.get(groupId, key, []);
      const updated = safeRemoveFromArray(current, predicate);
      await state.set(groupId, key, updated);
    } finally {
      mutex.release();
    }
  }
}
```

### 原子对象合并

```typescript
/**
 * 安全的对象合并
 */
export function safeMergeObject<T extends object>(
  obj: T | undefined,
  updates: Partial<T>
): T {
  if (!obj) return updates as T;
  return { ...obj, ...updates };
}

/**
 * 原子对象更新
 */
export class StateLockManager {
  async atomicObjectUpdate<T extends object>(
    state: State,
    groupId: string,
    key: string,
    updates: Partial<T>
  ): Promise<void> {
    const lockKey = `${groupId}:${key}`;
    const mutex = this.getLock(lockKey);

    await mutex.acquire();

    try {
      const current = await state.get(groupId, key);
      const updated = safeMergeObject(current, updates);
      await state.set(groupId, key, updated);
    } finally {
      mutex.release();
    }
  }
}
```

## 递归检测

### 问题场景

当 State.get 触发事件，事件处理器又调用 State.get，可能导致无限递归：

```
state.get(key)
  └─> emit('state.get', key)
      └─> event handler
          └─> state.get(key)  // 递归！
              └─> emit('state.get', key)
                  └─> ...  // 栈溢出
```

### safeStateGet 实现

```typescript
const MAX_RECURSION_DEPTH = 100;
const activeGets = new Map<string, number>();

/**
 * 安全的状态获取操作
 */
export async function safeStateGet<T>(
  state: State,
  groupId: string,
  key: string,
  fallback?: T
): Promise<T> {
  const callKey = `${groupId}:${key}`;

  // 获取当前递归深度
  const currentDepth = activeGets.get(callKey) || 0;

  // 检查递归深度
  if (currentDepth > MAX_RECUR_DEPTH_DEPTH) {
    console.warn(`Maximum recursion depth (${MAX_RECURSION_DEPTH}) exceeded for ${callKey}`);
    return fallback as T;
  }

  // 增加递归深度
  activeGets.set(callKey, currentDepth + 1);

  try {
    return await state.get(groupId, key, fallback);
  } finally {
    // 减少递归深度
    activeGets.set(callKey, currentDepth);
  }
}
```

### 使用示例

```typescript
// ❌ 危险：可能导致栈溢出
export default defineStep({
  name: 'dangerous-step',
  run: async (input, { state, emit }) => {
    // 这个 get 可能触发递归
    const value = await state.get('group', 'key');
    emit('value.updated', value);
    return { success: true };
  },
});

// ✅ 安全：使用 safeStateGet
export default defineStep({
  name: 'safe-step',
  run: async (input, { state, emit }) => {
    // 防止递归
    const value = await safeStateGet(state, 'group', 'key');
    emit('value.updated', value);
    return { success: true };
  },
});
```

## 资源限制

### 并发限制

```typescript
class AgentManager {
  private readonly maxSessions: number;
  private activeRequests = 0;
  private requestQueue: Array<() => void> = [];

  async acquire(sessionId: string, options?: AcquireOptions): Promise<Agent> {
    return new Promise((resolve, reject) => {
      const acquireRequest = async () => {
        if (this.activeRequests >= this.maxSessions) {
          // 达到限制，排队
          this.requestQueue.push(acquireRequest);
          return;
        }

        this.activeRequests++;

        try {
          const agent = this.getOrCreateAgent(sessionId, options);
          resolve(agent);
        } catch (error) {
          reject(error);
        }
      };

      acquireRequest();
    });
  }

  async release(sessionId: string): Promise<void> {
    await this.cleanup(sessionId);
    this.activeRequests--;

    // 处理队列中的请求
    const nextRequest = this.requestQueue.shift();
    if (nextRequest) {
      setImmediate(nextRequest);
    }
  }
}
```

### 内存限制

```typescript
export class MemoryLimiter {
  private readonly maxMemoryMB: number;
  private checkInterval?: NodeJS.Timeout;

  constructor(maxMemoryMB: number = 1024) { // 默认 1GB
    this.maxMemoryMB = maxMemoryMB;
  }

  start(): void {
    this.checkInterval = setInterval(() => {
      this.checkMemory();
    }, 5000); // 每 5 秒检查一次
  }

  stop(): void {
    if (this.checkInterval) {
      clearInterval(this.checkInterval);
      this.checkInterval = undefined;
    }
  }

  private checkMemory(): void {
    const usedMemoryMB = process.memoryUsage().heapUsed / 1024 / 1024;

    if (usedMemoryMB > this.maxMemoryMB) {
      console.error(`Memory usage exceeds limit: ${usedMemoryMB}MB / ${this.maxMemoryMB}MB`);
      // 触发清理或拒绝新请求
      this.handleMemoryOverflow(usedMemoryMB);
    }
  }

  private handleMemoryOverflow(usedMemoryMB: number): void {
    // 可以实现以下策略：
    // 1. 拒绝新请求
    // 2. 清理过期会话
    // 3. 触发垃圾回收
    // 4. 发送告警

    global.gc?.(); // 如果启用了 --expose-gc
  }
}
```

### 速率限制

```typescript
export class RateLimiter {
  private requests = new Map<string, number[]>();
  private readonly windowMs: number;
  private readonly maxRequests: number;

  constructor(windowMs: number = 60000, maxRequests: number = 100) {
    this.windowMs = windowMs;   // 时间窗口（毫秒）
    this.maxRequests = maxRequests; // 最大请求数
  }

  /**
   * 检查是否允许请求
   */
  async checkLimit(key: string): Promise<boolean> {
    const now = Date.now();
    let userRequests = this.requests.get(key) || [];

    // 清理过期的请求
    userRequests = userRequests.filter(
      timestamp => now - timestamp < this.windowMs
    );

    // 检查是否超过限制
    if (userRequests.length >= this.maxRequests) {
      return false;
    }

    // 记录新请求
    userRequests.push(now);
    this.requests.set(key, userRequests);

    return true;
  }

  /**
   * 获取剩余配额
   */
  getRemainingQuota(key: string): number {
    const now = Date.now();
    const userRequests = this.requests.get(key) || [];
    const validRequests = userRequests.filter(
      timestamp => now - timestamp < this.windowMs
    );

    return Math.max(0, this.maxRequests - validRequests.length);
  }

  /**
   * 重置限制
   */
  reset(key: string): void {
    this.requests.delete(key);
  }
}
```

## 并发最佳实践

### 1. 使用会话隔离

```typescript
// ✅ 好：使用会话隔离
const groupId = `agent:${sessionId}`;
await state.set(groupId, 'userName', 'Leo');

// ❌ 不好：使用全局键（容易冲突）
await state.set('userName', 'Leo');
```

### 2. 原子更新共享状态

```typescript
// ✅ 好：原子更新
await stateLockManager.atomicUpdate(state, groupId, 'counter', (c) => c + 1);

// ❌ 不好：读写分离（竞态条件）
const count = await state.get(groupId, 'counter');
await state.set(groupId, 'counter', count + 1);
```

### 3. 防止递归调用

```typescript
// ✅ 好：使用 safeStateGet
const value = await safeStateGet(state, groupId, 'key');

// ❌ 不好：直接使用 state.get（可能递归）
const value = await state.get(groupId, 'key');
```

### 4. 设置合理的超时

```typescript
// ✅ 好：设置会话超时
const agentManager = new AgentManager({
  sessionTimeout: 1800000, // 30 分钟
  maxSessions: 1000,
});

// ❌ 不好：没有超时（资源泄漏）
const agentManager = new AgentManager({
  sessionTimeout: Infinity,
  maxSessions: Infinity,
});
```

### 5. 监控资源使用

```typescript
// ✅ 好：监控资源
const memoryLimiter = new MemoryLimiter(1024); // 1GB 限制
memoryLimiter.start();

// 在适当的时候停止
process.on('SIGTERM', () => {
  memoryLimiter.stop();
});

// ❌ 不好：不监控资源（内存泄漏）
// 什么都不做
```

## 并发调试

### 锁竞争检测

```typescript
export class LockDebugger {
  private lockHolders = new Map<string, { holder: string; timestamp: number }>();

  recordAcquire(lockKey: string, holder: string): void {
    this.lockHolders.set(lockKey, {
      holder,
      timestamp: Date.now(),
    });
  }

  recordRelease(lockKey: string): void {
    this.lockHolders.delete(lockKey);
  }

  dumpLocks(): string[] {
    const now = Date.now();
    return Array.from(this.lockHolders.entries()).map(([key, holder]) => {
      const heldTime = now - holder.timestamp;
      return `${key} held by ${holder.holder} for ${heldTime}ms`;
    });
  }
}
```

### 竞态条件检测

```typescript
export class RaceConditionDetector {
  private accesses = new Map<string, number[]>();

  recordAccess(key: string, operation: 'read' | 'write'): void {
    const timestamp = Date.now();
    const accessKey = `${key}:${operation}`;
    const accesses = this.accesses.get(accessKey) || [];

    // 检查在短时间内的读写交替
    const recentWrites = this.accesses.get(`${key}:write`) || [];
    const recentReads = this.accesses.get(`${key}:read`) || [];

    if (operation === 'read' && recentWrites.length > 0) {
      const lastWrite = recentWrites[recentWrites.length - 1];
      if (timestamp - lastWrite < 100) { // 100ms 内
        console.warn(`Potential race condition detected for ${key}`);
      }
    }

    accesses.push(timestamp);
    this.accesses.set(accessKey, accesses);
  }
}
```

