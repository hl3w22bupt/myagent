| `metadata` | object | 元数据 |

## 委派规则

### 触发条件

```yaml
delegationRules:
  triggers:
    - review              # 包含 "review" 关键词
    - code quality         # 包含 "code quality"
    - anti-pattern          # 包含 "anti-pattern"
```

### 正则表达式匹配

```yaml
delegationRules:
  patterns:
    - (review|analyze|check).*(code|file)   # 匹配 "review code"
    - (security|vulnerability).*(check|audit)  # 匹配 "security audit"
```

### 复杂度级别

| 级别 | 描述 |
|------|------|
| `low` | 简单任务（如格式检查） |
| `medium` | 中等任务（如代码分析） |
| `high` | 复杂任务（如全面审查） |
| `extreme` | 极复杂任务（如大型项目重构） |

## 子代理发现

### 扫描子代理

```typescript
import { readdir, readFile } from 'fs/promises';
import { join } from 'path';
import { load } from 'js-yaml';

export class SubagentDiscovery {
  private subagentsDir: string;

  constructor(subagentsDir: string = './subagents') {
    this.subagentsDir = subagentsDir;
  }

  /**
   * 发现所有子代理
   */
  async discoverSubagents(): Promise<SubagentInfo[]> {
    const subagentDirs = await this.scanSubagentDirectories();
    const subagents: SubagentInfo[] = [];

    for (const subagentDir of subagentDirs) {
      try {
        const subagentInfo = await this.loadSubagentInfo(subagentDir);
        subagents.push(subagentInfo);
      } catch (error) {
        console.warn(`Failed to load subagent ${subagentDir}:`, error);
      }
    }

    return subagents;
  }

  /**
   * 扫描子代理目录
   */
  private async scanSubagentDirectories(): Promise<string[]> {
    const entries = await readdir(this.subagentsDir, {
      withFileTypes: true,
    });

    return entries
      .filter(entry => entry.isDirectory)
      .map(entry => entry.name);
  }

  /**
   * 加载子代理信息
   */
  private async loadSubagentInfo(subagentDir: string): Promise<SubagentInfo> {
    const configPath = join(this.subagentsDir, subagentDir, 'subagent.yaml');
    const configContent = await readFile(configPath, 'utf-8');
    const config = load(configContent) as SubagentConfig;

    // 加载系统提示词
    const systemPrompt = await this.loadSystemPrompt(
      subagentDir,
      config.systemPrompt
    );

    return {
      id: config.id,
      name: config.name,
      version: config.version,
      description: config.description,
      systemPrompt,
      capabilities: config.capabilities,
      languages: config.languages,
      availableSkills: config.availableSkills,
      delegationRules: config.delegationRules,
      performance: config.performance,
      cost: config.cost,
      metadata: config.metadata,
      path: join(this.subagentsDir, subagentDir),
    };
  }

  /**
   * 加载系统提示词
   */
  private async loadSystemPrompt(
    subagentDir: string,
    systemPromptPath: string
  ): Promise<string> {
    // 如果是相对路径，则从子代理目录读取
    if (systemPromptPath.startsWith('./') || systemPromptPath.startsWith('../')) {
      const fullPath = join(this.subagentsDir, subagentDir, systemPromptPath);
      return await readFile(fullPath, 'utf-8');
    }

    // 否则作为直接文本返回
    return systemPromptPath;
  }
}
```

## 委派决策

### 委派评分

```typescript
export class DelegationDecider {
  constructor(
    private subagents: Map<string, SubagentInfo>
  ) {}

  /**
   * 决定委派
   */
  async decideDelegation(task: string): Promise<DelegationDecision> {
    const scores: Array<{ subagentId: string; score: number }> = [];

    for (const [id, subagent] of this.subagents.entries()) {
      const score = await this.scoreSubagent(task, subagent);
      scores.push({ subagentId: id, score });
    }

    // 按评分排序
    scores.sort((a, b) => b.score - a.score);

    // 选择最高分的子代理
    const bestMatch = scores[0];

    if (bestMatch.score < 0.5) {
      // 评分过低，不委派
      return {
        shouldDelegate: false,
        reason: 'No suitable subagent found',
      };
    }

    return {
      shouldDelegate: true,
      subagentId: bestMatch.subagentId,
      confidence: bestMatch.score,
      alternatives: scores.slice(1, 3).map(s => ({
        subagentId: s.subagentId,
        confidence: s.score,
      })),
    };
  }

  /**
   * 评估子代理得分
   */
  private async scoreSubagent(
    task: string,
    subagent: SubagentInfo
  ): Promise<number> {
    let score = 0;
    const taskLower = task.toLowerCase();

    // 1. 关键词匹配（40% 权重）
    const keywordScore = this.scoreByKeywords(taskLower, subagent);
    score += keywordScore * 0.4;

    // 2. 正则匹配（30% 权重）
    const patternScore = this.scoreByPatterns(task, subagent);
    score += patternScore * 0.3;

    // 3. 性能优先级（20% 权重）
    const priorityScore = (subagent.performance?.priority || 5) / 10;
    score += priorityScore * 0.2;

    // 4. 成本考虑（10% 权重，成本越低得分越高）
    const costScore = this.scoreByCost(subagent);
    score += costScore * 0.1;

    // 应用最小置信度阈值
    const minConfidence = subagent.delegationRules?.minConfidence || 0;
    if (score < minConfidence) {
      return 0;
    }

    return Math.min(score, 1); // 确保得分不超过 1
  }

  /**
   * 按关键词评分
   */
  private scoreByKeywords(task: string, subagent: SubagentInfo): number {
    const triggers = subagent.delegationRules?.triggers || [];
    const matches = triggers.filter(trigger =>
      task.includes(trigger.toLowerCase())
    );

    return matches.length / Math.max(triggers.length, 1);
  }

  /**
   * 按正则评分
   */
  private scoreByPatterns(task: string, subagent: SubagentInfo): number {
    const patterns = subagent.delegationRules?.patterns || [];
    const matches = patterns.filter(pattern => {
      try {
        const regex = new RegExp(pattern, 'i');
        return regex.test(task);
      } catch (error) {
        console.warn(`Invalid pattern: ${pattern}`, error);
        return false;
      }
    });

    return matches.length / Math.max(patterns.length, 1);
  }

  /**
   * 按成本评分（成本越低得分越高）
   */
  private scoreByCost(subagent: SubagentInfo): number {
    const cost = subagent.cost || {};
    const tokenCost = cost.tokensPer1M || 0;
    const skillCost = cost.skillCalls || 0;

    // 假设最大 token 成本为 1
    const normalizedTokenCost = Math.min(tokenCost, 1);

    // 成本得分 = 1 - 归一化成本
    return 1 - (normalizedTokenCost * 0.7 + skillCost * 0.3);
  }
}
```

