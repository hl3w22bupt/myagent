## Zod 验证 Schema

### 执行请求验证

```typescript
import { z } from 'zod';

export const executeRequestSchema = z.object({
  task: z.string().min(1).max(10000),
  sessionId: z.string().uuid().optional(),
  systemPrompt: z.string().min(1).max(5000).optional(),
  useDelegation: z.boolean().optional().default(false),
  availableSkills: z.array(z.string()).optional(),
  subagents: z.array(z.string()).optional(),
  options: z.object({
    timeout: z.number().min(1000).max(600000).optional(),
    maxIterations: z.number().min(1).max(50).optional(),
  }).optional(),
});

export type ExecuteRequest = z.infer<typeof executeRequestSchema>;
```

### 任务查询验证

```typescript
export const taskQuerySchema = z.object({
  sessionId: z.string().uuid().optional(),
  status: z.enum(['pending', 'running', 'completed', 'failed']).optional(),
  page: z.coerce.number().int().min(1).default(1),
  pageSize: z.coerce.number().int().min(1).max(100).default(20),
  sortBy: z.enum(['createdAt', 'updatedAt']).optional().default('createdAt'),
  order: z.enum(['asc', 'desc']).optional().default('desc'),
});

export type TaskQuery = z.infer<typeof taskQuerySchema>;
```

## 中间件

### 验证中间件

```typescript
import { z } from 'zod';
import { NextFunction } from 'express';

export function validateRequest<T>(
  schema: z.ZodSchema<T>
) {
  return async (req: any, res: any, next: NextFunction) => {
    try {
      const validated = schema.parse(req.body);
      req.validatedBody = validated;
      next();
    } catch (error) {
      if (error instanceof z.ZodError) {
        res.status(400).json({
          success: false,
          error: {
            code: 'VALIDATION_ERROR',
            message: 'Invalid request body',
            details: error.errors,
          },
        });
      } else {
        next(error);
      }
    }
  };
}

// 使用
app.post('/agent/execute',
  validateRequest(executeRequestSchema),
  (req, res) => {
    const validatedBody: ExecuteRequest = req.validatedBody;
    // 处理请求
  }
);
```

### 错误处理中间件

```typescript
export enum ErrorType {
  VALIDATION = 'validation_error',
  PERMISSION = 'permission_error',
  NOT_FOUND = 'not_found',
  TIMEOUT = 'timeout_error',
  RATE_LIMIT = 'rate_limit_error',
  INTERNAL = 'internal_error',
  EXTERNAL = 'external_error',
}

export class ApplicationError extends Error {
  constructor(
    public type: ErrorType,
    message: string,
    public code?: string,
    public details?: any
  ) {
    super(message);
    this.name = 'ApplicationError';
  }
}

export function errorHandler(
  error: Error,
  req: any,
  res: any,
  next: NextFunction
) {
  if (error instanceof ApplicationError) {
    const statusCode = getStatusCode(error.type);

    res.status(statusCode).json({
      success: false,
      error: {
        code: error.code || error.type,
        message: error.message,
        details: error.details,
      },
      timestamp: Date.now(),
    });
  } else {
    // 未知错误
    res.status(500).json({
      success: false,
      error: {
        code: 'INTERNAL_ERROR',
        message: 'An unexpected error occurred',
      },
      timestamp: Date.now(),
    });
  }
}

function getStatusCode(errorType: ErrorType): number {
  switch (errorType) {
    case ErrorType.VALIDATION:
      return 400;
    case ErrorType.PERMISSION:
      return 403;
    case ErrorType.NOT_FOUND:
      return 404;
    case ErrorType.TIMEOUT:
      return 408;
    case ErrorType.RATE_LIMIT:
      return 429;
    default:
      return 500;
  }
}
```

### 认证中间件

```typescript
export function authenticate(req: any, res: any, next: NextFunction) {
  const authHeader = req.headers.authorization;

  if (!authHeader) {
    throw new ApplicationError(
      ErrorType.PERMISSION,
      'Authorization header required',
      'AUTH_REQUIRED'
    );
  }

  const [type, credentials] = authHeader.split(' ');

  if (type !== 'Bearer') {
    throw new ApplicationError(
      ErrorType.PERMISSION,
      'Unsupported authentication type',
      'UNSUPPORTED_AUTH_TYPE'
    );
  }

  // 验证 token
  try {
    const user = verifyToken(credentials);
    req.user = user;
    next();
  } catch (error) {
    throw new ApplicationError(
      ErrorType.PERMISSION,
      'Invalid or expired token',
      'INVALID_TOKEN'
    );
  }
}
```

## 实时流 API

### WebSocket 连接

```typescript
import { WebSocket } from 'ws';

export class TaskStream {
  private connections = new Map<string, WebSocket[]>();

  /**
   * 订阅任务更新
   */
  subscribe(taskId: string, ws: WebSocket): void {
    if (!this.connections.has(taskId)) {
      this.connections.set(taskId, []);
    }
    this.connections.get(taskId)!.push(ws);

    ws.on('close', () => {
      this.unsubscribe(taskId, ws);
    });
  }

  /**
   * 取消订阅
   */
  unsubscribe(taskId: string, ws: WebSocket): void {
    const connections = this.connections.get(taskId);
    if (connections) {
      const index = connections.indexOf(ws);
      if (index !== -1) {
        connections.splice(index, 1);
      }
    }
  }

  /**
   * 广播任务更新
   */
  broadcast(taskId: string, update: any): void {
    const connections = this.connections.get(taskId);
    if (connections) {
      const message = JSON.stringify({
        type: 'task-update',
        taskId,
        data: update,
      });

      for (const ws of connections) {
        if (ws.readyState === WebSocket.OPEN) {
          ws.send(message);
        }
      }
    }
  }
}
```

### 客户端示例

```javascript
// WebSocket 连接
const ws = new WebSocket('ws://localhost:3000/stream/tasks/task-456');

ws.onopen = () => {
  // 订阅任务更新
  ws.send(JSON.stringify({
    action: 'subscribe',
    taskId: 'task-456',
  }));
};

ws.onmessage = (event) => {
  const message = JSON.parse(event.data);

  if (message.type === 'task-update') {
    console.log('任务更新:', message.data);
    // 更新 UI
  }
};

ws.onclose = () => {
  console.log('连接关闭');
};

ws.onerror = (error) => {
  console.error('WebSocket 错误:', error);
};
```

## API 版本控制

### 版本策略

| 策略 | 说明 |
|------|------|
| **URL 路径** | `/api/v1/`, `/api/v2/` |
| **语义化版本** | 遵循语义化版本规范 |
| **向后兼容** | 新版本保持向后兼容 |
| **废弃通知** | 废弃端点返回警告 |

### 废弃通知

```typescript
export function deprecationWarning(message: string) {
  return async (req: any, res: any, next: NextFunction) => {
    res.setHeader('X-API-Deprecation', message);
    console.warn(`[DEPRECATED] ${message} - ${req.method} ${req.url}`);
    next();
  };
}

// 使用
app.get('/api/v1/old-endpoint',
  deprecationWarning('Use /api/v2/new-endpoint instead'),
  handler
);
```

## 最佳实践

### 1. 始终验证输入

```typescript
// ✅ 好：验证所有输入
app.post('/agent/execute',
  validateRequest(executeRequestSchema),
  handler
);

// ❌ 不好：跳过验证
app.post('/agent/execute', handler);
```

### 2. 使用语义化 HTTP 状态码

```typescript
// ✅ 好：正确的状态码
if (!task) {
  return res.status(404).json({ error: 'Task not found' });
}

// ❌ 不好：总是返回 200
return res.status(200).json({
  success: false,
  error: 'Task not found',
});
```

### 3. 提供有用的错误消息

```typescript
// ✅ 好：清晰的错误消息
throw new ApplicationError(
  ErrorType.VALIDATION,
  'Task must be between 1 and 10000 characters',
  'TASK_LENGTH_INVALID',
  { providedLength: task.length }
);

// ❌ 不好：模糊的错误消息
throw new Error('Invalid input');
```

### 4. 支持分页和过滤

```typescript
// ✅ 好：支持分页
app.get('/agent/tasks',
  validateRequest(taskQuerySchema),
  async (req, res) => {
    const { page, pageSize, status } = req.validatedQuery;
    const tasks = await taskStore.list({
      status,
      page,
      pageSize,
    });
    res.json(paginateResponse(tasks, page, pageSize));
  }
);
```

### 5. 记录 API 调用

```typescript
// ✅ 好：记录请求
app.use((req, res, next) => {
  const startTime = Date.now();

  res.on('finish', () => {
    const duration = Date.now() - startTime;
    logger.info('API request', {
      method: req.method,
      path: req.path,
      statusCode: res.statusCode,
      duration,
    });
  });

  next();
});
```

