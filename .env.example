# Sandbox Configuration
DEFAULT_SANDBOX_ADAPTER=local

# Local Sandbox
PYTHON_PATH=python3
SANDBOX_TIMEOUT=30000
SANDBOX_WORKSPACE=/tmp/motia-sandbox

# Daytona (Optional)
# DAYTONA_API_KEY=

# E2B (Optional)
# E2B_API_KEY=

# Modal (Optional)
# MODAL_TOKEN=

# ============================================================================
# LLM Configuration
# ============================================================================

# API Key - Can be used for multiple providers
ANTHROPIC_API_KEY=

# LLM Provider Selection
# Options:
#   - anthropic: Use Anthropic SDK (compatible with Claude and GLM-4.7 Anthropic API)
#   - openai-compatible: Use OpenAI SDK (compatible with GLM-4, OpenAI, etc.)
DEFAULT_LLM_PROVIDER=anthropic

# Model Name
# For Anthropic Claude:
#   - claude-sonnet-4-5 (recommended)
#   - claude-3-5-sonnet-20241022
# For GLM with Anthropic-compatible API:
#   - glm-4.7 (recommended)
#   - glm-4.5-air
# For GLM with OpenAI-compatible API:
#   - glm-4
#   - glm-4-flash
#   - glm-4-plus
#   - glm-4-air
DEFAULT_LLM_MODEL=claude-sonnet-4-5

# Optional: Custom LLM API Base URL
# Leave empty to use provider's default

# For Anthropic-compatible providers (use with DEFAULT_LLM_PROVIDER=anthropic):
#   - Claude (default): https://api.anthropic.com
#   - GLM-4.7: https://open.bigmodel.cn/api/anthropic
#   - Other Anthropic-compatible APIs

# For OpenAI-compatible providers (use with DEFAULT_LLM_PROVIDER=openai-compatible):
#   - GLM-4: https://open.bigmodel.cn/api/paas/v4/
#   - OpenAI: https://api.openai.com/v1
#   - Other OpenAI-compatible APIs
LLM_BASE_URL=

# ============================================================================
# Example Configurations
# ============================================================================

# Example 1: Use Claude (Anthropic)
# DEFAULT_LLM_PROVIDER=anthropic
# DEFAULT_LLM_MODEL=claude-sonnet-4-5
# LLM_BASE_URL=https://api.anthropic.com

# Example 2: Use GLM-4.7 with Anthropic-compatible API (Recommended)
# DEFAULT_LLM_PROVIDER=anthropic
# DEFAULT_LLM_MODEL=glm-4.7
# LLM_BASE_URL=https://open.bigmodel.cn/api/anthropic

# Example 3: Use GLM-4 with OpenAI-compatible API
# DEFAULT_LLM_PROVIDER=openai-compatible
# DEFAULT_LLM_MODEL=glm-4
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# Example 4: Use OpenAI
# DEFAULT_LLM_PROVIDER=openai-compatible
# DEFAULT_LLM_MODEL=gpt-4
# LLM_BASE_URL=https://api.openai.com/v1

# ============================================================================
# Agent Configuration
# ============================================================================

# Task Execution
TASK_TIMEOUT=600000              # Task execution timeout in milliseconds (default: 10 minutes)
MAX_ITERATIONS=5                 # Maximum agent iterations per task (default: 5)

# Retry Configuration
MAX_RETRIES=3                    # Maximum retry attempts for failed operations (default: 3)
RETRY_BASE_DELAY=1000            # Base delay for retries in milliseconds (default: 1000)
RETRY_MAX_DELAY=30000            # Maximum delay for retries in milliseconds (default: 30000)
RETRY_EXPONENTIAL_BACKOFF=true   # Use exponential backoff for retries (default: true)

# Session Management
SESSION_TIMEOUT=1800000          # Session timeout in milliseconds (default: 30 minutes)
MAX_SESSIONS=1000                # Maximum number of concurrent sessions (default: 1000)

# Redis (Optional - for production)
# REDIS_URL=redis://localhost:6379
